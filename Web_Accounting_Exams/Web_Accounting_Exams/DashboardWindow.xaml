<Window x:Class="Web_Accounting_Exams.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Web_Accounting_Exams.Converters"
        Title="Dashboard - Электронный учет ЦТ" Height="800" Width="1400"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <converters:RoleConverter x:Key="RoleConverter"/>
        <converters:InitialConverter x:Key="InitialConverter"/>
        
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2D3748" Offset="0"/>
            <GradientStop Color="#1A202C" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="UserAvatarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3748"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="#4C51BF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarGradient}">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <materialDesign:PackIcon Kind="School" Width="32" Height="32" 
                                       Foreground="#667eea" VerticalAlignment="Center"/>
                <TextBlock Text="ЦТ Portal" FontSize="20" FontWeight="Bold" 
                         Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <Button x:Name="CTApplicationsButton" Style="{StaticResource ActiveMenuButtonStyle}" 
                        Click="CTApplications_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentEdit" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Подача на ЦТ" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ExamsButton" Style="{StaticResource MenuButtonStyle}" 
                        Click="Exams_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentCheck" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Экзамены" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ScheduleButton" Style="{StaticResource MenuButtonStyle}" 
                        Click="Schedule_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Calendar" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Расписание экзаменов" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="UniversitiesButton" Style="{StaticResource MenuButtonStyle}" 
                        Click="Universities_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SchoolOutline" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Университеты" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <Button x:Name="SettingsButton" Style="{StaticResource MenuButtonStyle}" 
                        Click="Settings_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Settings" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="LogoutButton" Style="{StaticResource MenuButtonStyle}" 
                        Click="Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ExitToApp" Width="20" Height="20" 
                                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock Text="Выход" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="#F7FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" materialDesign:ElevationAssist.Elevation="Dp2" 
                               Background="White" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageTitleTextBlock" Text="Подача на ЦТ" 
                             FontSize="24" FontWeight="Bold" Foreground="#2D3748"
                             VerticalAlignment="Center" Margin="30,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                              VerticalAlignment="Center" Margin="0,0,30,0">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Margin="0,0,15,0">
                            <TextBlock x:Name="UserNameTextBlock" 
                                     Text="{Binding CurrentUser.FullName, FallbackValue='Пользователь'}" 
                                     FontSize="14" FontWeight="SemiBold" Foreground="#2D3748"
                                     HorizontalAlignment="Right"/>
                            <TextBlock x:Name="UserTypeTextBlock" 
                                     Text="{Binding IsAdmin, Converter={StaticResource RoleConverter}, FallbackValue='Абитуриент'}" 
                                     FontSize="12" Foreground="#718096"
                                     HorizontalAlignment="Right"/>
                        </StackPanel>

                        <Border Width="45" Height="45" CornerRadius="22.5" 
                              Background="{StaticResource UserAvatarGradient}"
                              VerticalAlignment="Center">
                            <TextBlock x:Name="UserInitialTextBlock" 
                                     Text="{Binding CurrentUser.FirstName, Converter={StaticResource InitialConverter}, FallbackValue='П'}" 
                                     FontSize="18" FontWeight="Bold" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="MainContentPresenter" Margin="30">
                </ContentPresenter>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>