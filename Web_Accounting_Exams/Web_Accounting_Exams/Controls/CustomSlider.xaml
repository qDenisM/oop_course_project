<UserControl x:Class="Web_Accounting_Exams.Controls.CustomSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Slider x:Name="SliderControl"
                    Minimum="{Binding Minimum, ElementName=Root}"
                    Maximum="{Binding Maximum, ElementName=Root}"
                    Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                    TickFrequency="{Binding TickFrequency, ElementName=Root}"
                    IsSnapToTickEnabled="True"
                    Height="30"
                    ValueChanged="SliderControl_ValueChanged"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="{Binding Minimum, ElementName=Root, StringFormat='{}{0}'}"
                       FontSize="12" 
                       Foreground="#757575"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1" 
                    Background="#6C5CE7" 
                    CornerRadius="4" 
                    Padding="8,4"
                    Margin="10,0">
                <TextBlock x:Name="ValueTextBlock"
                           Text="{Binding Value, ElementName=Root, StringFormat='{}{0:F0}'}"
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="2" 
                       Text="{Binding Maximum, ElementName=Root, StringFormat='{}{0}'}"
                       FontSize="12" 
                       Foreground="#757575"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>

            <TextBlock Grid.Column="1"
                       x:Name="LabelTextBlock"
                       Text="{Binding Label, ElementName=Root}"
                       FontSize="11"
                       Foreground="#757575"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>

