<Window x:Class="Web_Accounting_Exams.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация - Электронный учет ЦТ" Height="750" Width="1200"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00B894" Offset="0"/>
            <GradientStop Color="#00CEC9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#f8f9fa" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:1"/>
        </Storyboard>

        <Storyboard x:Key="SlideUpAnimation">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                              From="0,100,0,0" To="0,0,0,0" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <materialDesign:PackIcon Kind="AccountPlus" Width="80" Height="80" 
                                       Foreground="White" Margin="0,0,0,30"/>
                <TextBlock Text="Присоединяйтесь к нам!" FontSize="28" FontWeight="Bold" 
                         Foreground="White" TextAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Создайте аккаунт и получите доступ к современной системе электронного учета документов" 
                         FontSize="16" Foreground="White" TextAlignment="Center" 
                         TextWrapping="Wrap" Opacity="0.9" LineHeight="24" Margin="0,0,0,30"/>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" 
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Быстрая подача документов" Foreground="White" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" 
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Отслеживание статуса заявок" Foreground="White" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <materialDesign:PackIcon Kind="Check" Width="20" Height="20" 
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Безопасное хранение данных" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8" 
                                   Margin="40" Background="{StaticResource CardGradient}"
                                   x:Name="RegisterCard">
                    <materialDesign:Card.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource SlideUpAnimation}"/>
                        </EventTrigger>
                    </materialDesign:Card.Triggers>

                    <StackPanel Margin="40" VerticalAlignment="Center">
                        <TextBlock Text="Создать аккаунт" FontSize="32" FontWeight="Bold" 
                                 Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="FirstNameTextBox" Grid.Column="0" Grid.Row="0"
                                   materialDesign:HintAssist.Hint="Имя"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   FontSize="14" Margin="0,0,0,15" Height="50"
                                   Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox x:Name="LastNameTextBox" Grid.Column="2" Grid.Row="0"
                                   materialDesign:HintAssist.Hint="Фамилия"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   FontSize="14" Margin="0,0,0,15" Height="50"
                                   Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox x:Name="EmailTextBox" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                                   materialDesign:HintAssist.Hint="Email адрес"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   FontSize="14" Margin="0,0,0,15" Height="50"
                                   Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox x:Name="PhoneTextBox" Grid.Column="0" Grid.Row="2"
                                   materialDesign:HintAssist.Hint="Телефон"
                                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                   FontSize="14" Margin="0,0,0,15" Height="50"
                                   Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                            <DatePicker x:Name="BirthDatePicker" Grid.Column="2" Grid.Row="2"
                                      materialDesign:HintAssist.Hint="Дата рождения"
                                      Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                      FontSize="14" Margin="0,0,0,15" Height="50"
                                      SelectedDate="{Binding BirthDate}"/>

                            <PasswordBox x:Name="PasswordBox" Grid.Column="0" Grid.Row="3"
                                       materialDesign:HintAssist.Hint="Пароль"
                                       Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                       FontSize="14" Margin="0,0,0,15" Height="50"
                                       PasswordChanged="PasswordBox_PasswordChanged"/>

                            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Column="2" Grid.Row="3"
                                       materialDesign:HintAssist.Hint="Подтвердите пароль"
                                       Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                       FontSize="14" Margin="0,0,0,15" Height="50"
                                       PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                        </Grid>

                        <CheckBox x:Name="AgreementCheckBox" Margin="0,0,0,20"
                                  IsChecked="{Binding AgreementAccepted}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Я согласен с " Foreground="#757575"/>
                                <TextBlock Text="пользовательским соглашением" Foreground="#6C5CE7" 
                                         Cursor="Hand" MouseLeftButtonUp="Agreement_Click"/>
                                <TextBlock Text=" и " Foreground="#757575"/>
                                <TextBlock Text="политикой конфиденциальности" Foreground="#6C5CE7" 
                                         Cursor="Hand" MouseLeftButtonUp="Privacy_Click"/>
                            </StackPanel>
                        </CheckBox>

                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                              Content="ЗАРЕГИСТРИРОВАТЬСЯ" Background="#00B894" BorderBrush="#00B894"
                              Height="48" FontSize="16" FontWeight="Bold"
                              materialDesign:ElevationAssist.Elevation="Dp4"
                              Click="Register_Click" Margin="0,0,0,40"/>

                          

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Уже есть аккаунт? " Foreground="#757575"/>
                            <TextBlock Text="Войти" Foreground="#6C5CE7" 
                                     Cursor="Hand" MouseLeftButtonUp="Login_Click"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>
        </Grid>

        <Button Grid.Column="0" Style="{StaticResource MaterialDesignIconButton}"
                Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20" Click="Back_Click">
            <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="White"/>
        </Button>
    </Grid>
</Window>