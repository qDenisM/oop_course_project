<Window x:Class="Web_Accounting_Exams.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Web_Accounting_Exams.Converters"
        Title="Вход в систему - Электронный учет ЦТ" Height="600" Width="1000"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#f8f9fa" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:1"/>
        </Storyboard>

        <Storyboard x:Key="SlideUpAnimation">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                              From="0,100,0,0" To="0,0,0,0" Duration="0:0:0.8"/>
        </Storyboard>
        
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                <materialDesign:PackIcon Kind="School" Width="80" Height="80" 
                                       Foreground="White" Margin="0,0,0,30"/>
                <TextBlock Text="Электронный учет ЦТ" FontSize="28" FontWeight="Bold" 
                         Foreground="White" TextAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Добро пожаловать в систему электронного учета документов для центрального тестирования" 
                         FontSize="16" Foreground="White" TextAlignment="Center" 
                         TextWrapping="Wrap" Opacity="0.9" LineHeight="24"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8" 
                               Margin="40" Background="{StaticResource CardGradient}"
                               x:Name="LoginCard">
                <materialDesign:Card.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource SlideUpAnimation}"/>
                    </EventTrigger>
                </materialDesign:Card.Triggers>

                <StackPanel Margin="40" VerticalAlignment="Center">
                    <TextBlock Text="Вход в систему" FontSize="32" FontWeight="Bold" 
                             Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <TextBox x:Name="EmailTextBox" materialDesign:HintAssist.Hint="Email адрес"
                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                           FontSize="16" Margin="0,0,0,20" Height="56"
                           Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="Пароль"
                               Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                               FontSize="16" Margin="0,0,0,10" Height="56"
                               PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBlock Text="Забыли пароль?" Foreground="#6C5CE7" 
                             HorizontalAlignment="Right" Margin="0,0,0,30"
                             Cursor="Hand" MouseLeftButtonUp="ForgotPassword_Click"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                          Content="ВОЙТИ" Background="#6C5CE7" BorderBrush="#6C5CE7"
                          Height="48" FontSize="16" FontWeight="Bold"
                          materialDesign:ElevationAssist.Elevation="Dp4"
                          Command="{Binding LoginCommand}" 
                          Margin="0,0,0,20"/>

                    

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Нет аккаунта? " Foreground="#757575"/>
                        <TextBlock Text="Зарегистрироваться" Foreground="#6C5CE7" 
                                 Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding NavigateToRegisterCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
        
        <Button Grid.Column="0" Style="{StaticResource MaterialDesignIconButton}"
                Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20" Click="Back_Click">
            <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24" Foreground="White"/>
        </Button>
    </Grid>
</Window>