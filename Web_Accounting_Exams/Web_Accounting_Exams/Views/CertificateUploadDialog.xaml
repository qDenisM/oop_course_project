<Window x:Class="Web_Accounting_Exams.Views.CertificateUploadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Загрузка сертификата" Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о сертификате" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Тип сертификата:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="TypeComboBox" Height="40" Margin="0,0,0,15">
                <ComboBoxItem Content="ЦТ" Tag="CT"/>
                <ComboBoxItem Content="Аттестат" Tag="Diploma"/>
            </ComboBox>

            <TextBlock Text="Предмет:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="SubjectTextBox" Height="40" Margin="0,0,0,15"/>

            <TextBlock Text="Баллы:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="ScoreTextBox" Height="40" Margin="0,0,0,15"/>

            <TextBlock Text="Номер сертификата:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CertificateNumberTextBox" Height="40" Margin="0,0,0,15"/>

            <TextBlock x:Name="OCRResultTextBlock" TextWrapping="Wrap" 
                       Foreground="Gray" FontSize="12" Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Сохранить" IsDefault="True" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

