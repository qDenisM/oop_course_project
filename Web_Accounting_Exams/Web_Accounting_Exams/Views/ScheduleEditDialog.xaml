<Window x:Class="Web_Accounting_Exams.Views.ScheduleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Редактирование расписания" Height="600" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о расписании" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Экзамен:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="ExamComboBox" Height="40" Margin="0,0,0,15"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Выберите экзамен (обязательно)"/>

                <TextBlock Text="Дата экзамена:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="ExamDatePicker" Height="40" Margin="0,0,0,15"
                            materialDesign:HintAssist.Hint="Выберите дату экзамена (обязательно)"/>

                <TextBlock Text="Время начала:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="TimeTextBox" Height="40" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Формат: HH:mm (7:00 - 16:00) (обязательно)"/>

                <TextBlock Text="Университет (место проведения):" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="UniversityComboBox" Height="40" Margin="0,0,0,15"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="Выберите университет (обязательно)"/>

                <TextBlock Text="Максимальное количество участников:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="MaxParticipantsTextBox" Height="40" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Введите максимальное количество участников (макс. 1000)"/>

                <CheckBox x:Name="IsActiveCheckBox" Content="Расписание активно" 
                          Margin="0,15,0,0" IsChecked="True"
                          ToolTip="Активные расписания доступны для выбора при подаче заявок"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Сохранить" IsDefault="True" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

