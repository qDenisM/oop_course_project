<Window x:Class="Web_Accounting_Exams.Views.UniversityManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление университетами" Height="700" Width="1200"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление университетами" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="UniversitiesDataGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding University.Name}" Width="*"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding University.Address}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding University.Phone}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding University.Email}" Width="*"/>
                <DataGridTextColumn Header="Веб-сайт" Binding="{Binding University.Website}" Width="*"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding University.CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding University.IsActive}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00B894" Click="EditButton_Click"/>
            <Button Content="Управление специальностями" Width="200" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#764ba2" Click="ManageSpecialitiesButton_Click"/>
            <Button Content="Удалить" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#E74C3C" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

