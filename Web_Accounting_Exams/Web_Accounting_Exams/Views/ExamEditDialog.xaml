<Window x:Class="Web_Accounting_Exams.Views.ExamEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Редактирование экзамена" Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация об экзамене" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Название экзамена:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox" Height="40" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Введите название экзамена (обязательно)"/>

                <TextBlock Text="Предмет:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="SubjectTextBox" Height="40" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Введите название предмета (обязательно)"/>

                <TextBlock Text="Описание:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox" Height="100" TextWrapping="Wrap" 
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"
                         materialDesign:HintAssist.Hint="Введите описание экзамена (необязательно)"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Длительность (минуты):" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="DurationTextBox" Height="40"
                                 materialDesign:HintAssist.Hint="Например: 180"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Максимальный балл:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="MaxScoreTextBox" Height="40"
                                 materialDesign:HintAssist.Hint="Например: 100"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="IsActiveCheckBox" Content="Экзамен активен" 
                          Margin="0,15,0,0" IsChecked="True"
                          ToolTip="Активные экзамены доступны для выбора при подаче заявок"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Сохранить" IsDefault="True" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

