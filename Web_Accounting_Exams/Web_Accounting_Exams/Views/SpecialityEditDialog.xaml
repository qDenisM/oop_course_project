<Window x:Class="Web_Accounting_Exams.Views.SpecialityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Редактирование специальности" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о специальности" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Название:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="NameTextBox" Height="40" Margin="0,0,0,15"/>

            <TextBlock Text="Код:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="CodeTextBox" Height="40" Margin="0,0,0,15"/>

            <TextBlock Text="Описание:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionTextBox" Height="80" TextWrapping="Wrap" 
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Бюджетные места:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="BudgetPlacesTextBox" Height="40" Margin="0,0,0,15"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Платные места:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="PaidPlacesTextBox" Height="40" Margin="0,0,0,15"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Проходной балл (бюджет):" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="PassingScoreBudgetTextBox" Height="40"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Проходной балл (платное):" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="PassingScorePaidTextBox" Height="40"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="IsActiveCheckBox" Content="Активна" 
                      Margin="0,0,0,0" IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" Width="100" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Сохранить" IsDefault="True" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

