<Window x:Class="Web_Accounting_Exams.Views.SubjectManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление предметами" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="Управление предметами" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="SubjectsDataGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected}" Width="80"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject.SubjectName}" Width="*"/>
                <DataGridTextColumn Header="Мин. балл" Binding="{Binding Subject.MinScore}" Width="150"/>
                <DataGridCheckBoxColumn Header="Обязательный" Binding="{Binding Subject.IsRequired}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00B894" Click="EditButton_Click"/>
            <Button Content="Удалить" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#E74C3C" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

