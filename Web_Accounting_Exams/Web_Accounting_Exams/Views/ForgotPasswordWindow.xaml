<Window x:Class="Web_Accounting_Exams.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Восстановление пароля" Height="750" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#F5F5F5">
        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8" 
                               Margin="30" Background="White">
            <StackPanel Margin="30" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="LockReset" Width="64" Height="64" 
                                       Foreground="#6C5CE7" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Восстановление пароля" FontSize="24" FontWeight="Bold" 
                         Foreground="#2D3436" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Введите ваш email адрес и мы отправим вам код для восстановления пароля" 
                         FontSize="14" Foreground="#757575" TextWrapping="Wrap" 
                         TextAlignment="Center" Margin="0,0,0,30"/>

                <TextBox x:Name="EmailTextBox" materialDesign:HintAssist.Hint="Email адрес"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       FontSize="14" Margin="0,0,0,20" Height="65"
                       materialDesign:HintAssist.IsFloating="True"/>

                <TextBox x:Name="CodeTextBox" materialDesign:HintAssist.Hint="Код восстановления"
                       Style="{StaticResource MaterialDesignOutlinedTextBox}"
                       FontSize="14" Margin="0,0,0,20" Height="50"
                       materialDesign:HintAssist.IsFloating="True"
                       Visibility="Collapsed"/>

                <PasswordBox x:Name="NewPasswordBox" materialDesign:HintAssist.Hint="Новый пароль"
                           Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                           FontSize="14" Margin="0,0,0,20" Height="50"
                           Visibility="Collapsed"/>

                <PasswordBox x:Name="ConfirmPasswordBox" materialDesign:HintAssist.Hint="Подтвердите пароль"
                           Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                           FontSize="14" Margin="0,0,0,30" Height="50"
                           Visibility="Collapsed"/>

                <Button x:Name="ActionButton" Style="{StaticResource MaterialDesignRaisedButton}"
                      Content="Отправить код" Background="#6C5CE7" BorderBrush="#6C5CE7"
                      Height="48" FontSize="16" FontWeight="Bold"
                      Click="ActionButton_Click" Margin="0,0,0,15"/>

                <Button Content="Отмена" Style="{StaticResource MaterialDesignOutlinedButton}"
                      Height="40"                       Click="CancelButton_Click"/>

                <TextBlock x:Name="StatusTextBlock" Text="" FontSize="12"
                         Foreground="#6C5CE7" TextWrapping="Wrap" 
                         HorizontalAlignment="Center" Margin="0,15,0,0"
                         Visibility="Collapsed"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>

