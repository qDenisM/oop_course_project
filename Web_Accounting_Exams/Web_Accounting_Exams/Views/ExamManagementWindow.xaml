<Window x:Class="Web_Accounting_Exams.Views.ExamManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление экзаменами" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление экзаменами" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="ExamsDataGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  Margin="0,0,0,20"
                  SelectionChanged="ExamsDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Exam.Name}" Width="*"/>
                <DataGridTextColumn Header="Предмет" Binding="{Binding Exam.Subject}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Exam.Description}" Width="*"/>
                <DataGridTextColumn Header="Длительность (мин)" Binding="{Binding Exam.DurationMinutes}" Width="120"/>
                <DataGridTextColumn Header="Макс. балл" Binding="{Binding Exam.MaxScore}" Width="100"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding Exam.CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding Exam.IsActive}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <Button Content="Добавить" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00B894" Click="EditButton_Click"/>
            <Button Content="Удалить" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#E74C3C" Click="DeleteButton_Click"/>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="1" 
                CornerRadius="5" Padding="15" Margin="0,0,0,10"
                Background="#F5F5F5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Добавление результатов экзаменов" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Экзамен:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ExamComboBox" 
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedExamForResult, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Exams}"
                              Margin="0,0,0,10"
                              SelectionChanged="ExamComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Абитуриент:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ApplicantComboBox" 
                              DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedApplicationForResult, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding CompletedApplications}"
                              IsEnabled="{Binding IsApplicationEnabled}"
                              Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Bottom">
                    <Button Content="Добавить результат" Width="150" Height="40"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#00B894"
                            Command="{Binding AddExamResultCommand}"
                            IsEnabled="{Binding CanAddResult}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,10,10,0">
                    <TextBlock Text="Баллы:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="ScoreTextBox" 
                             Text="{Binding ResultScore, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" VerticalAlignment="Center"
                             IsEnabled="{Binding IsApplicationEnabled}"/>
                    <TextBlock Text="/" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <TextBlock Text="{Binding ResultMaxScore}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                    <TextBlock Text="Комментарий:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="CommentsTextBox" 
                             Text="{Binding ResultComments, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="60" MaxHeight="100"
                             IsEnabled="{Binding IsApplicationEnabled}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

