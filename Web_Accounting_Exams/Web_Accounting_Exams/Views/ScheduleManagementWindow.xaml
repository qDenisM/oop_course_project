<Window x:Class="Web_Accounting_Exams.Views.ScheduleManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление расписанием" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление расписанием экзаменов" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="ScheduleDataGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected}" Width="80"/>
                <DataGridTextColumn Header="Экзамен" Binding="{Binding Schedule.Exam.Name}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Schedule.ExamDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                <DataGridTextColumn Header="Время" Binding="{Binding Schedule.StartTime, StringFormat='{}{0:hh\\:mm}'}" Width="100"/>
                <DataGridTextColumn Header="Место" Binding="{Binding Schedule.Location}" Width="*"/>
                <DataGridTextColumn Header="Макс. участников" Binding="{Binding Schedule.MaxParticipants}" Width="120"/>
                <DataGridTextColumn Header="Зарегистрировано" Binding="{Binding Schedule.CurrentParticipants}" Width="120"/>
                <DataGridTextColumn Header="Свободно мест" Binding="{Binding FreePlaces}" Width="120"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding Schedule.CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Width="120"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding Schedule.IsActive}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Добавить" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#667eea" Click="AddButton_Click"/>
            <Button Content="Редактировать" Width="120" Height="40" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#00B894" Click="EditButton_Click"/>
            <Button Content="Удалить" Width="120" Height="40"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#E74C3C" Click="DeleteButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

