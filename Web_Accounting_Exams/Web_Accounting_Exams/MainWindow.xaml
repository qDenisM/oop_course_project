<Window x:Class="Web_Accounting_Exams.MainWindow"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Web_Accounting_Exams"
        Title="Электронный учет ЦТ" Height="900" Width="1600"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#f093fb" Offset="0"/>
            <GradientStop Color="#f5f7fa" Offset="1"/>
        </LinearGradientBrush>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:1.5"/>
        </Storyboard>

        <Storyboard x:Key="SlideInAnimation">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                              From="-500,0,0,0" To="50,0,0,0" Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" materialDesign:ElevationAssist.Elevation="Dp8" 
                            Margin="20,15,20,0">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="450"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0">
                    <materialDesign:PackIcon Kind="School" Width="36" Height="36" 
                                           Foreground="#6C5CE7" VerticalAlignment="Center"/>
                    <TextBlock Text="logo" FontSize="28" FontWeight="Bold" 
                             Foreground="#6C5CE7" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                          Content="Главная" Foreground="#6C5CE7" FontWeight="Bold" 
                          FontSize="16" Margin="0, 0, 35, 0" Padding="0,0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                          Content="Войти" FontSize="16" 
                          Margin="0, 0, 35, 0" Padding="0,0" Click="Login_Click"/>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                          Content="Начать сейчас" Background="#6C5CE7" BorderBrush="#6C5CE7"
                          Width="180" Height="45" FontSize="16" FontWeight="SemiBold"
                          Click="StartNow_Click"
                          materialDesign:ElevationAssist.Elevation="Dp4"/>
                </StackPanel>

                
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1" Margin="20,40,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="60,0,20,0"
                       x:Name="LeftContent">
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource SlideInAnimation}"/>
                    </EventTrigger>
                </StackPanel.Triggers>

                <TextBlock Text="Электронный" FontSize="72" FontWeight="ExtraBold" 
                         Foreground="#2D3436" Margin="0,0,0,15"
                         TextOptions.TextFormattingMode="Display"/>
                <TextBlock Text="учет ЦТ" FontSize="72" FontWeight="ExtraBold" 
                         Foreground="#6C5CE7" Margin="0,0,0,50"
                         TextOptions.TextFormattingMode="Display"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Легкий и быстрый способ подать документы в учебные заведения через веб сервис" 
          FontSize="20" Foreground="#636E72" TextWrapping="Wrap" 
          LineHeight="32" MaxWidth="500" Margin="0,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                  x:Name="RightContent">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                    </EventTrigger>
                </Grid.Triggers>

                <Ellipse Width="500" Height="500" Fill="#E8F5E8" Opacity="0.2"/>
                <Ellipse Width="400" Height="400" Fill="#DFF6FF" Opacity="0.3"/>
                <Ellipse Width="300" Height="300" Fill="#F0F8FF" Opacity="0.4"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    

                    <Canvas Width="400" Height="400" HorizontalAlignment="Center">
                        <materialDesign:Card Canvas.Left="50" Canvas.Top="30" Padding="10" 
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="∫∫∫ f(x,y,z) dxdydz" FontSize="14" Foreground="#74B9FF" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        <materialDesign:Card Canvas.Right="40" Canvas.Top="60" Padding="10"
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="lim(x→∞)" FontSize="14" Foreground="#E17055" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        
                        
                        <materialDesign:Card Canvas.Left="20" Canvas.Bottom="100" Padding="10"
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="dx/dt = k(x)" FontSize="14" Foreground="#A29BFE" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        <materialDesign:Card Canvas.Right="30" Canvas.Bottom="70" Padding="10"
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="Σ(n=1 to ∞)" FontSize="14" Foreground="#FD79A8" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        <materialDesign:Card Canvas.Top="40" Canvas.Left="150" Padding="10"
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="∂f/∂x + ∂f/∂y" FontSize="14" Foreground="#00CEC9" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        <materialDesign:Card Canvas.Left="80" Canvas.Top="180" Padding="10"
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="cos²θ + sin²θ = 1" FontSize="14" Foreground="#FDCB6E" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        <materialDesign:Card Canvas.Right="60" Canvas.Top="180" Padding="10"
                                           materialDesign:ElevationAssist.Elevation="Dp2">
                            <TextBlock Text="y = mx + b" FontSize="14"                             Foreground="#6C5CE7" FontWeight="SemiBold"/>
                        </materialDesign:Card>

                        <materialDesign:PackIcon Kind="FileDocument" Width="24" Height="24"
                                               Foreground="#55A3FF" Canvas.Left="300" Canvas.Top="120"/>
                        <materialDesign:PackIcon Kind="Calculator" Width="24" Height="24" 
                                               Foreground="#FF6B6B" Canvas.Left="80" Canvas.Top="120"/>
                        <materialDesign:PackIcon Kind="ChartLine" Width="24" Height="24" 
                                               Foreground="#4ECDC4" Canvas.Right="80" Canvas.Bottom="150"/>
                        <materialDesign:PackIcon Kind="Brain" Width="24" Height="24" 
                                               Foreground="#45B7D1" Canvas.Left="40" Canvas.Bottom="180"/>
                    </Canvas>
                </StackPanel>
            </Grid>
        </Grid>

        <materialDesign:Card Grid.Row="2" materialDesign:ElevationAssist.Elevation="Dp4" 
                            Margin="20,0,20,15">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" 
                                           Foreground="#00B894" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="1000+" FontSize="16" FontWeight="Bold" Foreground="#2D3436"/>
                        <TextBlock Text="Студентов" FontSize="12" Foreground="#636E72"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="School" Width="24" Height="24" 
                                           Foreground="#6C5CE7" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="50+" FontSize="16" FontWeight="Bold" Foreground="#2D3436"/>
                        <TextBlock Text="Учебных заведений" FontSize="12" Foreground="#636E72"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileMultiple" Width="24" Height="24" 
                                           Foreground="#E17055" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="5000+" FontSize="16" FontWeight="Bold" Foreground="#2D3436"/>
                        <TextBlock Text="Обработанных документов" FontSize="12" Foreground="#636E72"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Star" Width="24" Height="24" 
                                           Foreground="#FDCB6E" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="4.9/5" FontSize="16" FontWeight="Bold" Foreground="#2D3436"/>
                        <TextBlock Text="Рейтинг сервиса" FontSize="12" Foreground="#636E72"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>